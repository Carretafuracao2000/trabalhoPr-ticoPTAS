{
  "name": "trabalhopr-ticoptas",
  "version": "1.0.0",
  "description": "API de Biblioteca – Empréstimos e Multas",
  "main": "src/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:up": "docker start trabalhoPr-ticoPTAS || docker run -d --name trabalhoPr-ticoPTAS -p 127.0.0.1:27017:27017 -v trabalhoPr-ticoPTAS-data:/data/db mongo:8",
    "db:down": "docker stop trabalhoPr-ticoPTAS",
    "db:logs": "docker logs -f trabalhoPr-ticoPTAS",
    "db:reset": "docker rm -f trabalhoPr-ticoPTAS; docker volume rm trabalhoPr-ticoPTAS-data",
    "predev": "npm run db:up",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carretafuracao2000/trabalhoPr-ticoPTAS.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Carretafuracao2000/trabalhoPr-ticoPTAS/issues"
  },
  "homepage": "https://github.com/Carretafuracao2000/trabalhoPr-ticoPTAS#readme",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "mongodb": "^7.7.0"
  }
}
